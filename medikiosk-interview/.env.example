# ---- copy to `.env` and fill in. NEVER commit the real .env ----

# Sarvam API key (dashboard.sarvam.ai). Leave empty for mock mode.
SARVAM_API_KEY=

# Chat model for extraction/summary: sarvam-105b-conversations | sarvam-105b
LLM_MODEL=sarvam-105b-conversations

# STT: auto (realtime when a key exists) | realtime | rest
STT_PROVIDER=auto
STT_MODEL=saaras:v3
REALTIME_MODEL=saaras:v3-realtime
# End-of-turn silence ms (raise for noisy OPDs): 600 | 800 | 1000
REALTIME_SILENCE_MS=600

# Voice for spoken questions: bulbul:v2 (cheaper) | bulbul:v3 (better)
TTS_MODEL=bulbul:v2
TTS_SPEAKER=anushka

# Only for the TLS profile (docker compose --profile tls up -d)
KIOSK_DOMAIN=kiosk.example.in

# Frontend path (already set correctly in Docker; only override for bare runs)
# FRONTEND_PATH=/app/frontend/index.html
